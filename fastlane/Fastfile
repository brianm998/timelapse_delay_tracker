default_platform(:ios)

# Staged screenshots dir comes from SCREENSHOTS_DIR (the workflow stages en-US/*.png there).
platform :ios do
  desc "Upload App Store metadata and screenshots; optionally submit a processed build for review"
  lane :submit_review do |options|
    build_number = options[:build_number].to_s
    UI.user_error!("build_number must be digits only") unless build_number.match?(/\A[0-9]+\z/)
    submit = options[:submit].to_s == "true"
    screenshots = ENV["SCREENSHOTS_DIR"].to_s
    UI.user_error!("SCREENSHOTS_DIR is not a directory") unless File.directory?(screenshots)

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    notes = File.read(File.expand_path("../AppStore/review_notes.txt", __dir__)).strip

    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_binary_upload: true,
      metadata_path: File.expand_path("../AppStore/metadata", __dir__),
      screenshots_path: screenshots,
      overwrite_screenshots: true,
      build_number: build_number,
      submit_for_review: submit,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: true,
      app_review_information: { notes: notes },
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        add_id_info_uses_idfa: false,
        add_id_info_serves_ads: false,
        add_id_info_tracks_install: false,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: false
      }
    )
  end
end
